rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email is string;
    }

    function authEmail() {
      return signedIn() ? request.auth.token.email.lower() : '';
    }

    function isAdmin() {
      return signedIn() && authEmail() == 'paco@escuelalosmitos.com';
    }

    function staffAccessPath(appId) {
      return /databases/$(database)/documents/artifacts/$(appId)/staffAccess/$(authEmail());
    }

    function isTeacher(appId) {
      return signedIn()
        && exists(staffAccessPath(appId))
        && get(staffAccessPath(appId)).data.role == 'teacher'
        && get(staffAccessPath(appId)).data.email is string
        && get(staffAccessPath(appId)).data.email.lower() == authEmail();
    }

    function teacherMatchesData(appId, data) {
      return isTeacher(appId) && (
        ('teacherUid' in data && data.teacherUid is string && data.teacherUid == request.auth.uid)
        || ('teacherEmail' in data && data.teacherEmail is string && data.teacherEmail.lower() == authEmail())
        || (
          'teacher' in data
          && 'teacherNameLower' in get(staffAccessPath(appId)).data
          && data.teacher is string
          && data.teacher.lower() == get(staffAccessPath(appId)).data.teacherNameLower
        )
        || (
          'teacherName' in data
          && 'teacherNameLower' in get(staffAccessPath(appId)).data
          && data.teacherName is string
          && data.teacherName.lower() == get(staffAccessPath(appId)).data.teacherNameLower
        )
        || (
          'teacherNameNormalized' in data
          && 'teacherNameLower' in get(staffAccessPath(appId)).data
          && data.teacherNameNormalized is string
          && data.teacherNameNormalized == get(staffAccessPath(appId)).data.teacherNameLower
        )
      );
    }

    function teacherInAuthorizedClassEmails(appId, data) {
      return isTeacher(appId)
        && 'authorizedTeacherEmails' in data
        && data.authorizedTeacherEmails is list
        && authEmail() in data.authorizedTeacherEmails;
    }

    function teacherInTeacherEmails(appId, data) {
      return isTeacher(appId)
        && 'teacherEmails' in data
        && data.teacherEmails is list
        && authEmail() in data.teacherEmails;
    }

    function teacherInRecoveryTeacherEmails(appId, data) {
      return isTeacher(appId)
        && 'recoveryTeacherEmails' in data
        && data.recoveryTeacherEmails is list
        && authEmail() in data.recoveryTeacherEmails;
    }

    function teacherOwnsNamespace(appId, userId) {
      return isTeacher(appId) && request.auth.uid == userId;
    }

    function teacherCanReadClass(appId, userId, data) {
      return teacherMatchesData(appId, data)
        || teacherInAuthorizedClassEmails(appId, data);
    }

    function teacherInvalidatesAttendedTicket(appId, userId) {
      let data = request.resource.data;
      let attendance = getAfter(/databases/$(database)/documents/artifacts/$(appId)/users/$(userId)/records/$(data.attendanceRecordId)).data;
      return teacherOwnsNamespace(appId, userId)
        && authEmail() in resource.data.teacherEmails
        && resource.data.get('isUsed', false) == false
        && resource.data.get('voided', false) == false
        && data.isUsed == true && data.voided == true
        && data.voidReason == 'attendance_confirmed' && data.voidedBy == authEmail()
        && data.attendanceRecordId is string
        && data.diff(resource.data).affectedKeys().hasOnly([
          'isUsed', 'voided', 'voidReason', 'voidedAt', 'voidedBy',
          'attendanceRecordId', 'attendanceCorrectedOn', 'attendanceClassId'
        ])
        && attendance.date == data.attendanceCorrectedOn
        && attendance.classId == data.attendanceClassId
        && resource.data.studentId in attendance.presentStudentIds;
    }

    function teacherCanReadTicket(appId, data) {
      return teacherInTeacherEmails(appId, data)
        || teacherInRecoveryTeacherEmails(appId, data);
    }

    function accessPath(appId) {
      return /databases/$(database)/documents/artifacts/$(appId)/access/$(request.auth.uid);
    }

    function studentRecordPath(appId, studentId) {
      return /databases/$(database)/documents/artifacts/$(appId)/students/$(studentId);
    }

    function studentHasPortalEntitlement(appId, studentId) {
      let studentPath = studentRecordPath(appId, studentId);
      let studentData = get(studentPath).data;
      return studentId is string
        && studentId.matches('^[A-Za-z0-9_-]+$')
        && exists(studentPath)
        && (!('globalStatus' in studentData) || studentData.globalStatus != 'baja')
        && (
          ('classes' in studentData && studentData.classes is list && studentData.classes.size() > 0)
          || ('hasMitobox' in studentData && studentData.hasMitobox == true)
          || ('hasMitoverso' in studentData && studentData.hasMitoverso == true)
          || ('hasGymusik' in studentData && studentData.hasGymusik == true)
        );
    }

    function hasStudentAccess(appId) {
      let studentAccessPath = accessPath(appId);
      let accessData = get(studentAccessPath).data;
      return signedIn()
        && exists(studentAccessPath)
        && accessData.role == 'student'
        && accessData.email is string
        && accessData.email.lower() == authEmail()
        && accessData.studentId is string
        && accessData.studentId.matches('^[A-Za-z0-9_-]+$')
        // Compatibilidad durante el despliegue: los vínculos antiguos todavía
        // no tienen el campo. La nueva aplicación los actualiza al iniciar.
        && (!('portalEnabled' in accessData) || accessData.portalEnabled == true)
        && studentHasPortalEntitlement(appId, accessData.studentId);
    }

    function ownStudentId(appId) {
      return get(accessPath(appId)).data.studentId;
    }

    function ownsStudentRecord(appId, studentId) {
      return hasStudentAccess(appId) && ownStudentId(appId) == studentId;
    }

    function studentHasMitobox(appId) {
      return hasStudentAccess(appId)
        && get(studentRecordPath(appId, get(accessPath(appId)).data.studentId)).data.hasMitobox == true;
    }

    function gymusikMemberPath(appId, studentId) {
      return /databases/$(database)/documents/artifacts/$(appId)/gymusikMembers/$(studentId);
    }

    function studentHasGymusik(appId) {
      let studentId = ownStudentId(appId);
      let memberPath = gymusikMemberPath(appId, studentId);
      return hasStudentAccess(appId)
        && get(studentRecordPath(appId, studentId)).data.hasGymusik == true
        && exists(memberPath)
        && get(memberPath).data.status == 'active';
    }

    function gymusikSessionPath(appId, sessionId) {
      return /databases/$(database)/documents/artifacts/$(appId)/gymusikSessions/$(sessionId);
    }

    function gymusikReservationPath(appId, reservationId) {
      return /databases/$(database)/documents/artifacts/$(appId)/gymusikReservations/$(reservationId);
    }

    function gymusikReservationMatchesSession(appId, reservationId, sessionId, expectedStatus) {
      let reservationData = getAfter(gymusikReservationPath(appId, reservationId)).data;
      return reservationId is string
        && sessionId is string
        && existsAfter(gymusikReservationPath(appId, reservationId))
        && reservationData.studentId == ownStudentId(appId)
        && reservationData.studentEmail is string
        && reservationData.studentEmail.lower() == authEmail()
        && reservationData.sessionId == sessionId
        && reservationData.status == expectedStatus
        && (expectedStatus == 'cancelled'
          ? get(gymusikReservationPath(appId, reservationId)).data.status in ['confirmed', 'waitlist']
          : (!exists(gymusikReservationPath(appId, reservationId))
            || get(gymusikReservationPath(appId, reservationId)).data.status == 'cancelled'));
    }

    function gymusikCreditPath(appId, studentId, month) {
      return /databases/$(database)/documents/artifacts/$(appId)/gymusikCredits/$(studentId)/months/$(month);
    }

    function gymusikCreditPaired(appId, reservationId, data) {
      let path = gymusikCreditPath(appId, data.studentId, data.sessionDate[0:7]);
      let after = getAfter(path).data;
      return after.lastReservationId == reservationId
        && after.revision == (exists(path) ? get(path).data.revision : 0) + 1
        && (data.status == 'cancelled' && data.creditConsumed == false
          ? !(reservationId in after.reservationIds) : reservationId in after.reservationIds);
    }

    function studentUpdatesGymusikCredit(appId, studentId, month) {
      let data = request.resource.data;
      let path = gymusikCreditPath(appId, studentId, month);
      let previous = exists(path) ? get(path).data : {'reservationIds': [], 'revision': 0};
      let id = data.lastReservationId;
      let reservationPath = gymusikReservationPath(appId, id);
      let after = getAfter(reservationPath).data;
      let before = exists(reservationPath) ? get(reservationPath).data : {'status': ''};
      let ids = data.reservationIds;
      let old = previous.reservationIds;
      return studentHasGymusik(appId) && studentId == ownStudentId(appId)
        && get(gymusikMemberPath(appId, studentId)).data.creditLedgerVersion == 1
        && month.matches('^[0-9]{4}-[0-9]{2}$')
        && data.keys().hasOnly(['studentId', 'studentEmail', 'month', 'reservationIds', 'lastReservationId', 'revision', 'updatedAt'])
        && data.studentId == studentId && data.studentEmail == authEmail() && data.month == month
        && data.revision == previous.revision + 1 && ids is list && ids.toSet().size() == ids.size()
        && after.studentId == studentId && after.studentEmail == authEmail() && after.sessionDate[0:7] == month
        && (
          (after.status in ['confirmed', 'waitlist'] && before.status in ['', 'cancelled'] && id in ids
            && ids.hasAll(old) && ids.size() == old.size() + (id in old ? 0 : 1)
            && (id in old || ids.size() <= get(/databases/$(database)/documents/artifacts/$(appId)/gymusikSettings/main).data.monthlyCredits))
          || (after.status == 'cancelled' && before.status in ['confirmed', 'waitlist']
            && (after.creditConsumed == true ? ids.toSet() == old.toSet()
              : (!(id in ids) && old.hasAll(ids) && ids.size() == old.size() - (id in old ? 1 : 0))))
        );
    }

    match /artifacts/{appId}/gymusikCredits/{studentId}/months/{month} {
      allow get: if isAdmin() || (hasStudentAccess(appId) && studentId == ownStudentId(appId));
      allow list, delete: if isAdmin();
      allow create, update: if isAdmin() || studentUpdatesGymusikCredit(appId, studentId, month);
    }

    function mitoboxSlotPath(appId, slotId) {
      return /databases/$(database)/documents/artifacts/$(appId)/mitoboxSlots/$(slotId);
    }

    function mitoboxReservationPath(appId, reservationId) {
      return /databases/$(database)/documents/artifacts/$(appId)/mitoboxReservations/$(reservationId);
    }

    function reservationMatchesSlot(appId, reservationId, slotId, expectedStatus) {
      let reservationData = getAfter(mitoboxReservationPath(appId, reservationId)).data;
      return reservationId is string
        && slotId is string
        && existsAfter(mitoboxReservationPath(appId, reservationId))
        && reservationData.studentId == ownStudentId(appId)
        && reservationData.studentEmail is string
        && reservationData.studentEmail.lower() == authEmail()
        && reservationData.slotId == slotId
        && reservationData.reservationDate == request.resource.data.reservationDate
        && reservationData.reservationTime == request.resource.data.reservationTime
        && reservationData.status == expectedStatus
        && (expectedStatus == 'cancelled'
          ? get(mitoboxReservationPath(appId, reservationId)).data.status == 'confirmed'
          : (!exists(mitoboxReservationPath(appId, reservationId))
            || get(mitoboxReservationPath(appId, reservationId)).data.status == 'cancelled'));
    }

    function madridOffset(at) {
      let march = timestamp.date(at.year(), 3, 31);
      let october = timestamp.date(at.year(), 10, 31);
      let summer = march - duration.value(march.dayOfWeek() % 7, 'd') + duration.value(1, 'h');
      let winter = october - duration.value(october.dayOfWeek() % 7, 'd') + duration.value(1, 'h');
      return duration.value(at >= summer && at < winter ? 2 : 1, 'h');
    }

    function validMitoboxStart(data) {
      let local = data.startsAt + madridOffset(data.startsAt);
      let today = request.time + madridOffset(request.time);
      let parts = data.reservationDate.split('-');
      let time = data.reservationTime.split(':');
      return data.startsAt is timestamp
        && data.startsAt >= request.time + duration.value(24, 'h')
        && local.year() == int(parts[0]) && local.month() == int(parts[1]) && local.day() == int(parts[2])
        && local.hours() == int(time[0]) && local.minutes() == int(time[1]) && local.seconds() == 0
        && local.year() == today.year() && local.month() == today.month();
    }

    function schoolScheduledTime(date, time) {
      let parts = date.split('-');
      let clock = time.split(':');
      let local = timestamp.date(int(parts[0]), int(parts[1]), int(parts[2])) + duration.value(int(clock[0]), 'h') + duration.value(int(clock[1]), 'm');
      return local - madridOffset(local - duration.value(1, 'h'));
    }

    function validGymusikCancellation(appId, before, after) {
      let session = get(gymusikSessionPath(appId, before.sessionId)).data;
      let hours = get(/databases/$(database)/documents/artifacts/$(appId)/gymusikSettings/main).data.cancellationHours;
      let returned = before.status == 'waitlist' || schoolScheduledTime(session.date, session.time) >= request.time + duration.value(hours, 'h');
      return after.creditReturned == returned && after.creditConsumed == !returned;
    }

    function mitoboxSlotChanges(appId, reservationId, slotId, delta) {
      let path = mitoboxSlotPath(appId, slotId);
      let after = getAfter(path).data;
      return after.lastMutationId == reservationId
        && after.reservedCount == (exists(path) ? get(path).data.reservedCount : 0) + delta;
    }

    function gymusikSessionChanges(appId, reservationId, sessionId, previous, next) {
      let path = gymusikSessionPath(appId, sessionId);
      let before = get(path).data;
      let after = getAfter(path).data;
      return after.lastReservationId == reservationId
        && after.reservedCount == before.reservedCount + (next == 'confirmed' ? 1 : 0) - (previous == 'confirmed' ? 1 : 0)
        && after.waitlistCount == before.waitlistCount + (next == 'waitlist' ? 1 : 0) - (previous == 'waitlist' ? 1 : 0);
    }

    function ownStudentEmailRecord() {
      return signedIn()
        && resource.data.email is string
        && resource.data.email.lower() == authEmail();
    }

    function validStudentAvatarPath(studentId, avatarPath) {
      return avatarPath is string
        && avatarPath.split('/').size() == 4
        && avatarPath.split('/')[0] == 'studentAvatars'
        && avatarPath.split('/')[1] == request.auth.uid
        && avatarPath.split('/')[2] == studentId
        && avatarPath.split('/')[3].matches('^profile(-[0-9]+)?[.]webp$');
    }

    function studentOwnsResource(appId) {
      return hasStudentAccess(appId) && (
        (
          resource.data.studentId is string
          && resource.data.studentId == ownStudentId(appId)
        )
        || (
          'studentEmail' in resource.data
          && resource.data.studentEmail is string
          && resource.data.studentEmail == authEmail()
        )
        || (
          'email' in resource.data
          && resource.data.email is string
          && resource.data.email == authEmail()
        )
      );
    }

    function requestEmailMatchesAuth() {
      return (
        'studentEmail' in request.resource.data
        && request.resource.data.studentEmail is string
        && request.resource.data.studentEmail.lower() == authEmail()
      ) || (
        'email' in request.resource.data
        && request.resource.data.email is string
        && request.resource.data.email.lower() == authEmail()
      );
    }

    function studentCreatesOwnResource(appId) {
      return hasStudentAccess(appId)
        && request.resource.data.studentId is string
        && request.resource.data.studentId == ownStudentId(appId)
        && requestEmailMatchesAuth();
    }

    function deterministicIdBelongsToStudent(appId, documentId) {
      return hasStudentAccess(appId)
        && documentId.matches('^.*_' + ownStudentId(appId) + '$');
    }

    function studentCanReadAnnouncement(appId) {
      return hasStudentAccess(appId)
        && (('audienceType' in resource.data && resource.data.audienceType in ['all', 'sede', 'instrumento', 'profesor'])
          || ('recipientStudentIds' in resource.data && resource.data.recipientStudentIds is list && ownStudentId(appId) in resource.data.recipientStudentIds));
    }

    function studentNotifiesOwnAbsence(appId) {
      let data = request.resource.data;
      let date = data.lastAbsenceDate;
      let before = resource.data.get('exceptions', {});
      let after = data.exceptions;
      let own = ownStudentId(appId);
      let oldDay = before.get(date, {});
      let day = after[date];
      let oldCancelled = resource.data.get('autoCancelled', {});
      let cancelled = data.get('autoCancelled', {});
      return date is string && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.lastAbsenceStudentId == own && own in resource.data.studentIds
        && data.diff(resource.data).affectedKeys().hasOnly(['exceptions', 'autoCancelled', 'lastAbsenceDate', 'lastAbsenceStudentId'])
        && after.diff(before).affectedKeys().hasOnly([date])
        && day.diff(oldDay).affectedKeys().hasOnly([own])
        && day[own] in ['notified', 'notified_no_ticket'] && oldDay.get(own, '') != 'present'
        && (cancelled == oldCancelled || (
          cancelled.diff(oldCancelled).affectedKeys().hasOnly([date]) && cancelled[date] == true
          && day.keys().hasAll(resource.data.studentIds)
          && day.values().hasOnly(['absent', 'notified', 'notified_no_ticket'])
        ));
    }

    // Única lectura sin iniciar sesión.
    match /publicData/classAvailability {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /publicData/{document=**} {
      allow read, write: if false;
    }

    match /artifacts/{appId}/staffAccess/{staffEmail} {
      allow get: if isAdmin() || (
        signedIn()
        && staffEmail == authEmail()
      );
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /artifacts/{appId}/access/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if isAdmin() || (
        signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['role', 'studentId', 'email', 'portalEnabled', 'createdAt', 'updatedAt'])
        && request.resource.data.role == 'student'
        && request.resource.data.portalEnabled == true
        && request.resource.data.email is string
        && request.resource.data.email.lower() == authEmail()
        && request.resource.data.studentId is string
        && request.resource.data.studentId.matches('^[A-Za-z0-9_-]+$')
        && exists(/databases/$(database)/documents/artifacts/$(appId)/students/$(request.resource.data.studentId))
        && get(/databases/$(database)/documents/artifacts/$(appId)/students/$(request.resource.data.studentId)).data.email is string
        && get(/databases/$(database)/documents/artifacts/$(appId)/students/$(request.resource.data.studentId)).data.email.lower() == authEmail()
        && studentHasPortalEntitlement(appId, request.resource.data.studentId)
      );
      allow delete: if isAdmin();
    }

    match /artifacts/{appId}/students/{studentId} {
      allow get, list: if isAdmin() || isTeacher(appId) || ownsStudentRecord(appId, studentId) || ownStudentEmailRecord();
      allow create: if isAdmin() || (
        isTeacher(appId)
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'claimed', 'instruments', 'classes', 'internalNotes', 'classStartDate'
        ])
        && request.resource.data.claimed == false
      );
      allow delete: if isAdmin();
      allow update: if isAdmin() || (
        isTeacher(appId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['internalNotes'])
      ) || (
        (ownsStudentRecord(appId, studentId) || ownStudentEmailRecord())
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'claimed', 'authUid', 'lastSeenTablon', 'lastSeenExtras', 'lastSeenNotificationTray', 'triviaLastPlayed', 'triviaPoints', 'triviaStreak',
          'avatarPath', 'avatarUpdatedAt'
        ])
        // La foto ya guardada no debe bloquear claimed/authUid al iniciar sesión.
        // Validar su ruta únicamente cuando se añade o cambia la foto.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['avatarPath'])
          || !('avatarPath' in request.resource.data)
          || validStudentAvatarPath(studentId, request.resource.data.avatarPath))
      );
    }

    match /artifacts/{appId}/settings/{settingId} {
      allow read: if isAdmin() || isTeacher(appId);
      allow write: if isAdmin();
    }

    match /artifacts/{appId}/announcements/{announcementId} {
      allow get: if isAdmin() || isTeacher(appId) || studentCanReadAnnouncement(appId);
      // Each query proves its own audience restriction. Presence/type checks on
      // an unconstrained alternative cannot be proved by an array-contains query.
      allow list: if isAdmin() || isTeacher(appId);
      allow list: if hasStudentAccess(appId)
        && resource.data.audienceType in ['all', 'sede', 'instrumento', 'profesor'];
      allow list: if hasStudentAccess(appId)
        && ownStudentId(appId) in resource.data.recipientStudentIds;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        studentCanReadAnnouncement(appId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'pollVoteCounts', 'pollResponseCount', 'pollLastResponseAt'
        ])
      );
    }

    match /artifacts/{appId}/trayNotifications/{notificationId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /artifacts/{appId}/studentNotificationInbox/{studentEmail}/items/{notificationId} {
      allow get, list: if signedIn() && studentEmail == authEmail();
      allow create, update, delete: if isAdmin();
    }

    match /artifacts/{appId}/workshops/{workshopId} {
      allow read: if isAdmin() || isTeacher(appId) || hasStudentAccess(appId);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        hasStudentAccess(appId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'confirmedCount', 'pendingCount', 'waitlistCount', 'updatedAt'
        ])
      );
    }

    match /artifacts/{appId}/roleData/studentClassCatalog {
      allow read: if isAdmin() || isTeacher(appId) || hasStudentAccess(appId);
      allow write: if isAdmin();
    }

    match /artifacts/{appId}/roleData/studentSettings {
      allow read: if isAdmin() || isTeacher(appId) || hasStudentAccess(appId);
      allow write: if isAdmin();
    }

    match /artifacts/{appId}/roleData/{document=**} {
      allow read, write: if isAdmin();
    }

    function musicGameTotal(id) {
      return id == 'tempo-v1' ? 36 : id in ['echo-v1', 'contour-v1', 'layers-v1'] ? 32 : id in ['rhythm-v1', 'form-v1'] ? 24 : 16;
    }

    function validMusicIdentity(data) {
      let titles = {'tempo-v1': 'Detective del tempo', 'echo-v1': 'El eco perdido', 'rhythm-v1': 'Laboratorio de ritmos', 'contour-v1': 'El laberinto melódico', 'form-v1': 'El mapa de la canción', 'layers-v1': 'El mezclador secreto', 'composer-v1': 'Misión compositor'};
      return ('contentVersion' in data && data.contentVersion == 3)
        ? (data.challengeId in titles && data.challengeTitle == titles[data.challengeId]
          && data.generatorVersion == 1 && data.totalActivities == musicGameTotal(data.challengeId)
          && data.seed is string && data.seed.matches('^[0-9]{1,10}$')
          && data.sequenceOrdinal is int && data.sequenceOrdinal >= 0 && data.sequenceOrdinal < 1000000)
        : (data.challengeId == 'tempo-v1' && data.challengeTitle == 'Detective del tempo'
          && (!('contentVersion' in data) || data.contentVersion in [1, 2]));
    }

    function musicOrder(appId) {
      let settings = get(/databases/$(database)/documents/artifacts/$(appId)/roleData/studentSettings).data;
      let fallback = ['tempo-v1', 'echo-v1', 'rhythm-v1', 'contour-v1', 'form-v1', 'layers-v1', 'composer-v1'];
      let order = 'musicChallengeOrder' in settings ? settings.musicChallengeOrder : fallback;
      return order is list && order.size() == 7 && order.toSet().size() == 7 && order.hasOnly(fallback) ? order : fallback;
    }

    function nextMusicId(appId, last) {
      let order = musicOrder(appId);
      let index = order[0] == last ? 0 : order[1] == last ? 1 : order[2] == last ? 2 : order[3] == last ? 3 : order[4] == last ? 4 : order[5] == last ? 5 : 6;
      return order[(index + 1) % 7];
    }

    function musicStartPaired(appId, data, attemptId) {
      let progress = getAfter(/databases/$(database)/documents/artifacts/$(appId)/studentMusicProgress/$(data.studentId)).data;
      return progress.studentId == data.studentId && progress.lastAttemptId == attemptId
        && progress.lastVacationDate == data.vacationDate && progress.lastChallengeId == data.challengeId
        && progress.nextOrdinal == data.sequenceOrdinal + 1 && progress.updatedAt == request.time;
    }

    function validMusicProgress(appId, data, studentId) {
      let attempt = getAfter(/databases/$(database)/documents/artifacts/$(appId)/vacationChallengeAttempts/$(data.lastAttemptId)).data;
      return data.keys().hasOnly(['studentId', 'lastChallengeId', 'nextOrdinal', 'lastVacationDate', 'lastAttemptId', 'revision', 'updatedAt'])
        && data.studentId == studentId && studentId == ownStudentId(appId)
        && data.lastChallengeId in ['tempo-v1', 'echo-v1', 'rhythm-v1', 'contour-v1', 'form-v1', 'layers-v1', 'composer-v1']
        && data.nextOrdinal is int && data.nextOrdinal > 0 && data.nextOrdinal <= 1000000
        && data.revision is int && data.revision >= 0 && data.updatedAt == request.time
        && data.lastAttemptId == studentId + '_' + data.lastVacationDate
        && attempt.studentId == studentId && attempt.vacationDate == data.lastVacationDate
        && attempt.contentVersion == 3 && attempt.sequenceOrdinal == data.nextOrdinal - 1
        && attempt.challengeId == data.lastChallengeId && attempt.revision == 0
        && attempt.startedAt == request.time && attempt.updatedAt == request.time;
    }

    match /artifacts/{appId}/studentMusicProgress/{studentId} {
      allow get: if isAdmin() || (hasStudentAccess(appId) && studentId == ownStudentId(appId));
      allow list: if isAdmin();
      allow create: if isAdmin() || (hasStudentAccess(appId) && request.resource.data.revision == 0
        && validMusicProgress(appId, request.resource.data, studentId));
      allow update: if isAdmin() || (hasStudentAccess(appId)
        && resource.data.studentId == ownStudentId(appId)
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.nextOrdinal == resource.data.nextOrdinal + 1
        && request.resource.data.lastChallengeId == nextMusicId(appId, resource.data.lastChallengeId)
        && validMusicProgress(appId, request.resource.data, studentId));
      allow delete: if isAdmin();
    }

    function validVacationChallenge(appId, data) {
      let settings = get(/databases/$(database)/documents/artifacts/$(appId)/roleData/studentSettings).data;
      let total = 'contentVersion' in data && data.contentVersion == 3 ? musicGameTotal(data.challengeId) : 36;
      return data.vacationDate is string
        && data.vacationDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.vacationDate in settings.vacaciones
        && data.vacationDate in settings.vacationChallengeDeadlines
        && request.time < settings.vacationChallengeDeadlines[data.vacationDate]
        && validMusicIdentity(data)
        && data.studentName is string && data.studentName.size() <= 160
        && data.subject is string && data.subject.size() <= 100
        && data.classId is string && data.classId.size() <= 256
        && data.difficulty in ['beginner', 'advanced']
        && data.classOwnerUid is string && data.classOwnerUid.matches('^[^/]+$')
        && data.classDocumentId is string && data.classDocumentId.matches('^[^/]+$')
        && data.studentId in get(/databases/$(database)/documents/artifacts/$(appId)/users/$(data.classOwnerUid)/recurringClasses/$(data.classDocumentId)).data.studentIds
        && data.answers is list && data.answers.size() <= total
        && data.cursor is int && data.cursor >= 0 && data.cursor <= total
        && data.cursor <= data.answers.size()
        && data.answered == data.answers.size()
        && data.firstCorrect is int && data.firstCorrect >= 0 && data.firstCorrect <= data.answered
        && data.finalCorrect is int && data.finalCorrect >= 0 && data.finalCorrect <= data.answered
        && data.withHelp is int && data.withHelp >= 0 && data.withHelp <= data.answered
        && data.elapsedSeconds is int && data.elapsedSeconds >= 0
        && data.revision is int && data.revision >= 0
        && data.startedAt is timestamp && data.updatedAt == request.time
        && ((data.status == 'in_progress' && data.cursor < total)
          || (data.status == 'completed' && data.cursor == total && data.answers.size() == total && data.completedAt == request.time));
    }

    match /artifacts/{appId}/vacationChallengeAttempts/{attemptId} {
      allow get: if isAdmin() || (hasStudentAccess(appId)
        && attemptId.matches('^' + ownStudentId(appId) + '_[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
      allow list: if isAdmin() || (hasStudentAccess(appId) && resource.data.studentId == ownStudentId(appId));
      allow create: if isAdmin() || (studentCreatesOwnResource(appId)
        && attemptId == request.resource.data.studentId + '_' + request.resource.data.vacationDate
        && request.resource.data.keys().hasOnly([
          'studentId', 'studentEmail', 'studentName', 'vacationDate', 'challengeId', 'challengeTitle',
          'difficulty', 'contentVersion', 'generatorVersion', 'totalActivities', 'seed', 'sequenceOrdinal', 'classId', 'classOwnerUid', 'classDocumentId', 'subject', 'status', 'cursor',
          'answers', 'revision', 'elapsedSeconds', 'answered', 'firstCorrect', 'finalCorrect', 'withHelp', 'startedAt', 'updatedAt'
        ])
        && request.resource.data.status == 'in_progress'
        && request.resource.data.cursor == 0 && request.resource.data.answers.size() == 0
        && request.resource.data.revision == 0 && request.resource.data.startedAt == request.time
        && validVacationChallenge(appId, request.resource.data)
        && (!('contentVersion' in request.resource.data) || request.resource.data.contentVersion != 3 || musicStartPaired(appId, request.resource.data, attemptId)));
      allow update: if isAdmin() || (hasStudentAccess(appId)
        && resource.data.studentId == ownStudentId(appId)
        && resource.data.status == 'in_progress'
        && request.resource.data.revision == resource.data.revision + 1
        && (!('contentVersion' in resource.data) || resource.data.contentVersion == 1
          || request.resource.data.contentVersion == resource.data.contentVersion)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'cursor', 'answers', 'revision', 'elapsedSeconds', 'answered', 'firstCorrect', 'finalCorrect', 'withHelp', 'updatedAt', 'completedAt', 'difficulty', 'contentVersion'
        ])
        && validVacationChallenge(appId, request.resource.data));
      allow delete: if isAdmin();
    }

    function validMitoboxContractAcceptance(data) {
      let contract = data.mitoboxContract;
      return contract is map
        && contract.keys().hasAll(['version', 'studentId', 'accountEmail', 'authUid', 'signerFullName', 'studentFullName', 'role', 'monthlyFee', 'accepted', 'immediateStart', 'acceptedAt', 'text', 'sha256'])
        && contract.version == 'mitobox-2026-11-04-v2'
        && contract.studentId == data.studentId
        && contract.accountEmail == authEmail()
        && contract.authUid == request.auth.uid
        && contract.signerFullName is string && contract.signerFullName.size() >= 3 && contract.signerFullName.size() <= 160
        && contract.studentFullName is string && contract.studentFullName.size() >= 3 && contract.studentFullName.size() <= 160
        && contract.role in ['adult', 'guardian']
        && contract.monthlyFee in [35, 50]
        && data.extraMonthlyFee == contract.monthlyFee
        && contract.accepted == true && contract.immediateStart is bool
        && contract.acceptedAt == request.time
        && contract.text is string && contract.text.size() > 10000 && contract.text.size() < 60000
        && contract.sha256 is string && contract.sha256.matches('^[a-f0-9]{64}$');
    }

    function validMitoversoContractAcceptance(data) {
      let contract = data.mitoversoContract;
      return contract is map
        && contract.keys().hasAll(['version', 'studentId', 'accountEmail', 'authUid', 'signerFullName', 'studentFullName', 'role', 'monthlyFee', 'accepted', 'immediateStart', 'acceptedAt', 'text', 'sha256'])
        && contract.version == 'mitoverso-2026-11-05-v1'
        && contract.studentId == data.studentId
        && contract.accountEmail == authEmail()
        && contract.authUid == request.auth.uid
        && contract.signerFullName is string && contract.signerFullName.size() >= 3 && contract.signerFullName.size() <= 160
        && contract.studentFullName is string && contract.studentFullName.size() >= 3 && contract.studentFullName.size() <= 160
        && contract.role in ['adult', 'guardian']
        && contract.monthlyFee in [10, 20]
        && data.extraMonthlyFee == contract.monthlyFee
        && contract.accepted == true && contract.immediateStart is bool
        && contract.acceptedAt == request.time
        && contract.text is string && contract.text.size() > 10000 && contract.text.size() < 60000
        && contract.sha256 is string && contract.sha256.matches('^[a-f0-9]{64}$');
    }

    // Anonymous, date-specific capacity. A pupil can only add one hold, paired
    // atomically with their own request and exclusive ticket claim.
    function recoveryAvailabilityPath(appId, availabilityId) {
      return /databases/$(database)/documents/artifacts/$(appId)/recoveryAvailability/$(availabilityId);
    }
    function recoveryRequestPath(appId, gestionId) {
      return /databases/$(database)/documents/artifacts/$(appId)/gestiones/$(gestionId);
    }
    function recoveryClaimPath(appId, owner, ticketId) {
      return /databases/$(database)/documents/artifacts/$(appId)/recoveryTicketClaims/$(owner)/claims/$(ticketId);
    }
    function validStudentRecoveryRequest(appId, gestionId, data) {
      let availability = getAfter(recoveryAvailabilityPath(appId, data.recoveryAvailabilityId)).data;
      let claim = getAfter(recoveryClaimPath(appId, data.ticketOwnerUid, data.ticketDocumentId)).data;
      return data.status == 'pendiente' && data.recoveryCapacityVersion == 1
        && data.requestedClassRefPath == availability.classRefPath
        && data.requestedClass == availability.classId
        && availability.enabled == true
        && gestionId in availability.sessions[data.recoveryDate].holds
        && claim.gestionId == gestionId && claim.status == 'held'
        && claim.studentId == data.studentId && claim.studentEmail == data.studentEmail
        && claim.recoveryDate == data.recoveryDate
        && data.ticketRefPath == 'artifacts/' + appId + '/users/' + data.ticketOwnerUid + '/tickets/' + data.ticketDocumentId
        && claim.ticketRefPath == data.ticketRefPath;
    }
    function studentAddsRecoveryHold(appId, availabilityId) {
      let data = request.resource.data;
      let date = data.lastHoldDate;
      let id = data.lastHoldId;
      let before = resource.data.sessions[date];
      let after = data.sessions[date];
      let gestion = getAfter(recoveryRequestPath(appId, id)).data;
      return resource.data.enabled == true
        && data.diff(resource.data).affectedKeys().hasOnly(['sessions', 'revision', 'lastHoldId', 'lastHoldDate', 'updatedAt'])
        && data.revision == resource.data.revision + 1
        && data.sessions.diff(resource.data.sessions).affectedKeys().hasOnly([date])
        && after.diff(before).affectedKeys().hasOnly(['holds'])
        && before.cancelled == false
        && resource.data.capacity > before.baseCount + before.recoveryCount + before.holds.size()
        && !(id in before.holds) && after.holds.hasAll(before.holds)
        && after.holds.size() == before.holds.size() + 1
        && after.holds.toSet().size() == after.holds.size() && id in after.holds
        && gestion.type == 'recuperacion' && gestion.status == 'pendiente'
        && gestion.recoveryAvailabilityId == availabilityId
        && gestion.recoveryDate == date && gestion.studentId == ownStudentId(appId)
        && gestion.studentEmail == authEmail() && gestion.requestedClassRefPath == resource.data.classRefPath;
    }
    function teacherUpdatesRecoveryAvailability(appId) {
      let data = request.resource.data;
      let gestion = getAfter(recoveryRequestPath(appId, data.lastActionId)).data;
      return authEmail() in gestion.teacherEmails
        && gestion.type == 'recuperacion'
        && gestion.status in ['completado', 'rechazado', 'cancelado']
        && gestion.requestedClassRefPath == resource.data.classRefPath
        && gestion.recoveryDate == data.lastActionDate
        && data.diff(resource.data).affectedKeys().hasOnly(['sessions', 'revision', 'lastActionId', 'lastActionDate', 'updatedAt'])
        && data.revision == resource.data.revision + 1
        && data.sessions.diff(resource.data.sessions).affectedKeys().hasOnly([data.lastActionDate]);
    }
    match /artifacts/{appId}/recoveryAvailability/{availabilityId} {
      allow read: if isAdmin() || isTeacher(appId) || hasStudentAccess(appId);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isTeacher(appId) && teacherUpdatesRecoveryAvailability(appId))
        || (hasStudentAccess(appId) && studentAddsRecoveryHold(appId, availabilityId));
    }
    function studentClaimsRecoveryTicket(appId, owner, ticketId) {
      let data = request.resource.data;
      let ticket = get(/databases/$(database)/documents/artifacts/$(appId)/users/$(owner)/tickets/$(ticketId)).data;
      let gestion = getAfter(recoveryRequestPath(appId, data.gestionId)).data;
      let availability = getAfter(recoveryAvailabilityPath(appId, gestion.recoveryAvailabilityId)).data;
      return data.keys().hasOnly(['studentId', 'studentEmail', 'gestionId', 'ticketRefPath', 'recoveryDate', 'status', 'ticketOwnerUid', 'ticketDocumentId', 'expiresAt'])
        && data.studentId == ownStudentId(appId) && data.studentEmail == authEmail()
        && data.ticketOwnerUid == owner && data.ticketDocumentId == ticketId
        && data.ticketRefPath == 'artifacts/' + appId + '/users/' + owner + '/tickets/' + ticketId
        && ticket.studentId == ownStudentId(appId)
        && ticket.get('isUsed', false) == false && ticket.get('voided', false) == false
        && (ticket.get('validFrom', '') == '' || ticket.validFrom <= data.recoveryDate)
        && (ticket.get('validUntil', '') == '' || ticket.validUntil >= data.recoveryDate)
        && data.expiresAt == availability.sessions[data.recoveryDate].expiresAt
        && data.expiresAt > request.time
        && data.status == 'held' && gestion.type == 'recuperacion' && gestion.status == 'pendiente'
        && gestion.studentId == data.studentId && gestion.studentEmail == data.studentEmail
        && gestion.ticketOwnerUid == owner && gestion.ticketDocumentId == ticketId
        && gestion.ticketRefPath == data.ticketRefPath && gestion.recoveryDate == data.recoveryDate
        && data.gestionId in availability.sessions[data.recoveryDate].holds;
    }
    function teacherDecidesRecoveryClaim(appId, owner, ticketId) {
      let data = request.resource.data;
      let gestion = getAfter(recoveryRequestPath(appId, data.gestionId)).data;
      return authEmail() in gestion.teacherEmails
        && gestion.type == 'recuperacion' && gestion.ticketOwnerUid == owner && gestion.ticketDocumentId == ticketId
        && gestion.ticketRefPath == data.ticketRefPath && gestion.studentId == data.studentId
        && gestion.recoveryDate == data.recoveryDate
        && ((data.status == 'approved' && gestion.status == 'completado')
          || (data.status == 'released' && gestion.status in ['rechazado', 'cancelado']));
    }
    match /artifacts/{appId}/recoveryTicketClaims/{owner}/claims/{ticketId} {
      allow get: if isAdmin() || isTeacher(appId) || (hasStudentAccess(appId)
        && (!exists(recoveryClaimPath(appId, owner, ticketId)) || resource.data.studentId == ownStudentId(appId)));
      allow list: if isAdmin() || isTeacher(appId);
      allow create: if isAdmin() || (isTeacher(appId) && teacherDecidesRecoveryClaim(appId, owner, ticketId))
        || (hasStudentAccess(appId) && studentClaimsRecoveryTicket(appId, owner, ticketId));
      allow update: if isAdmin() || (isTeacher(appId) && teacherDecidesRecoveryClaim(appId, owner, ticketId)) || (
        hasStudentAccess(appId) && studentClaimsRecoveryTicket(appId, owner, ticketId)
        && resource.data.studentId == ownStudentId(appId)
        && (resource.data.status == 'released' || resource.data.expiresAt < request.time)
      );
      allow delete: if isAdmin();
    }

    match /artifacts/{appId}/gestiones/{gestionId} {
      // Los trámites forman parte del trabajo compartido: una recuperación puede
      // comenzar con un profesor y terminar en la clase de otro.
      allow read: if isAdmin() || isTeacher(appId) || studentOwnsResource(appId);
      allow create: if isAdmin() || teacherInTeacherEmails(appId, request.resource.data) || (
        studentCreatesOwnResource(appId)
        && request.resource.data.get('status', '') == 'pendiente'
        && request.resource.data.get('type', '') != 'reserva_mitobox'
        && request.resource.data.get('tadosiDone', false) == false
        && !request.resource.data.keys().hasAny(['tadosiDoneAt', 'tadosiDoneBy', 'skipTadosi', 'workflowStatus', 'mitoboxIdentityVerifiedAt', 'mitoboxIdentityVerifiedBy', 'mitoversoIdentityVerifiedAt', 'mitoversoIdentityVerifiedBy', 'extraServiceActivatedAt', 'scheduledAction', 'scheduledEffectiveDate'])
        && !request.resource.data.keys().hasAny(['legacyMitoboxMigrationApprovedAt', 'legacyMitoboxMigrationApprovedBy', 'consolidatedAt', 'executionMode'])
        && (request.resource.data.get('type', '') != 'recuperacion' || validStudentRecoveryRequest(appId, gestionId, request.resource.data))
        && (!('type' in request.resource.data) || request.resource.data.type != 'alta_mitobox'
          || validMitoboxContractAcceptance(request.resource.data))
        && (request.resource.data.get('type', '') != 'alta_mitoverso' || validMitoversoContractAcceptance(request.resource.data))
      );
      allow update: if isAdmin() || (
        teacherInTeacherEmails(appId, resource.data)
        && teacherInTeacherEmails(appId, request.resource.data)
        && request.resource.data.teacherEmails == resource.data.teacherEmails
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.studentEmail == resource.data.studentEmail
      ) || (
        studentOwnsResource(appId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminCopySentAt', 'adminCopyRecipient'])
      );
      allow delete: if isAdmin();
    }

    match /artifacts/{appId}/mitoboxReservations/{reservationId} {
      // El ID termina en el studentId para permitir leer de forma segura un
      // documento todavía inexistente dentro de la transacción de alta.
      allow get: if isAdmin()
        || (studentHasMitobox(appId) && deterministicIdBelongsToStudent(appId, reservationId))
        || studentOwnsResource(appId);
      allow list: if isAdmin() || studentOwnsResource(appId);
      allow create: if isAdmin() || (
        studentHasMitobox(appId)
        && studentCreatesOwnResource(appId)
        && request.resource.data.status == 'confirmed'
        && request.resource.data.slotId is string
        && request.resource.data.reservationDate is string
        && request.resource.data.reservationTime is string
        && validMitoboxStart(request.resource.data)
        && existsAfter(mitoboxSlotPath(appId, request.resource.data.slotId))
        && mitoboxSlotChanges(appId, reservationId, request.resource.data.slotId, 1)
      );
      allow update: if isAdmin() || (
        studentHasMitobox(appId)
        && studentOwnsResource(appId)
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.studentEmail == resource.data.studentEmail
        && (
          (
            resource.data.status == 'confirmed'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.cancelledBy == 'student'
            && mitoboxSlotChanges(appId, reservationId, resource.data.slotId, -1)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'cancelledAt', 'cancelledBy', 'updatedAt'
            ])
          )
          || (
            resource.data.status == 'cancelled'
            && request.resource.data.status == 'confirmed'
            && request.resource.data.reservationDate == resource.data.reservationDate
            && request.resource.data.reservationTime == resource.data.reservationTime
            && validMitoboxStart(request.resource.data)
            && mitoboxSlotChanges(appId, reservationId, request.resource.data.slotId, 1)
          )
        )
      );
      allow delete: if isAdmin();
    }

    match /artifacts/{appId}/mitoboxSlots/{slotId} {
      allow read: if isAdmin() || studentHasMitobox(appId);
      allow create: if isAdmin() || (
        studentHasMitobox(appId)
        && request.resource.data.keys().hasOnly([
          'reservationDate', 'reservationTime', 'centerId', 'roomId',
          'reservedCount', 'capacity', 'updatedAt', 'lastMutationId'
        ])
        && request.resource.data.reservedCount == 1
        && request.resource.data.capacity >= 1
        && request.resource.data.capacity == get(/databases/$(database)/documents/artifacts/$(appId)/roleData/studentSettings).data.mitoboxRoomCapacities[request.resource.data.centerId + '__' + request.resource.data.roomId]
        && request.resource.data.reservedCount <= request.resource.data.capacity
        && reservationMatchesSlot(appId, request.resource.data.lastMutationId, slotId, 'confirmed')
      );
      allow update: if isAdmin() || (
        studentHasMitobox(appId)
        && request.resource.data.reservationDate == resource.data.reservationDate
        && request.resource.data.reservationTime == resource.data.reservationTime
        && request.resource.data.centerId == resource.data.centerId
        && request.resource.data.roomId == resource.data.roomId
        && request.resource.data.capacity == resource.data.capacity
        && request.resource.data.reservedCount >= 0
        && request.resource.data.reservedCount <= request.resource.data.capacity
        && (
          request.resource.data.reservedCount == resource.data.reservedCount + 1
          && reservationMatchesSlot(appId, request.resource.data.lastMutationId, slotId, 'confirmed')
          || request.resource.data.reservedCount == resource.data.reservedCount - 1
          && reservationMatchesSlot(appId, request.resource.data.lastMutationId, slotId, 'cancelled')
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'reservedCount', 'updatedAt', 'lastMutationId'
        ])
      );
      allow delete: if isAdmin();
    }

    match /artifacts/{appId}/gymusikSettings/{settingId} {
      allow read: if isAdmin() || isTeacher(appId) || hasStudentAccess(appId);
      allow write: if isAdmin();
    }

    match /artifacts/{appId}/gymusikMembers/{studentId} {
      allow get: if isAdmin() || isTeacher(appId) || ownsStudentRecord(appId, studentId);
      allow list: if isAdmin() || isTeacher(appId);
      allow create: if isAdmin() || (
        ownsStudentRecord(appId, studentId)
        && request.resource.data.studentId == studentId
        && request.resource.data.studentEmail is string
        && request.resource.data.studentEmail.lower() == authEmail()
        && request.resource.data.status == 'preenrolled'
        && request.resource.data.keys().hasOnly([
          'studentId', 'studentName', 'studentEmail', 'instrument', 'status',
          'isCurrentStudent', 'createdAt', 'updatedAt', 'createdBy'
        ])
      );
      allow update, delete: if isAdmin();
    }

    match /artifacts/{appId}/gymusikSessions/{sessionId} {
      allow read: if isAdmin() || isTeacher(appId) || hasStudentAccess(appId);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        teacherMatchesData(appId, resource.data)
        && teacherMatchesData(appId, request.resource.data)
        && request.resource.data.teacherEmail == resource.data.teacherEmail
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'completedAt', 'completedBy', 'updatedAt'
        ])
      ) || (
        studentHasGymusik(appId)
        && request.resource.data.status == resource.data.status
        && request.resource.data.capacity == resource.data.capacity
        && request.resource.data.teacherEmail == resource.data.teacherEmail
        && request.resource.data.reservedCount >= 0
        && request.resource.data.waitlistCount >= 0
        && request.resource.data.reservedCount <= request.resource.data.capacity
        && request.resource.data.lastReservationId is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'reservedCount', 'waitlistCount', 'lastReservationId',
          'promotionPending', 'updatedAt'
        ])
        && (
          (
            request.resource.data.reservedCount == resource.data.reservedCount + 1
            && request.resource.data.waitlistCount == resource.data.waitlistCount
            && gymusikReservationMatchesSession(appId, request.resource.data.lastReservationId, sessionId, 'confirmed')
          )
          || (
            request.resource.data.waitlistCount == resource.data.waitlistCount + 1
            && request.resource.data.reservedCount == resource.data.reservedCount
            && gymusikReservationMatchesSession(appId, request.resource.data.lastReservationId, sessionId, 'waitlist')
          )
          || (
            request.resource.data.reservedCount == resource.data.reservedCount - 1
            && request.resource.data.waitlistCount == resource.data.waitlistCount
            && gymusikReservationMatchesSession(appId, request.resource.data.lastReservationId, sessionId, 'cancelled')
          )
          || (
            request.resource.data.waitlistCount == resource.data.waitlistCount - 1
            && request.resource.data.reservedCount == resource.data.reservedCount
            && gymusikReservationMatchesSession(appId, request.resource.data.lastReservationId, sessionId, 'cancelled')
          )
        )
      );
    }

    match /artifacts/{appId}/gymusikReservations/{reservationId} {
      allow get: if isAdmin()
        || teacherMatchesData(appId, resource.data)
        || studentOwnsResource(appId)
        || deterministicIdBelongsToStudent(appId, reservationId);
      allow list: if isAdmin() || teacherMatchesData(appId, resource.data) || studentOwnsResource(appId);
      allow create: if isAdmin() || (
        studentHasGymusik(appId)
        && studentCreatesOwnResource(appId)
        && request.resource.data.status in ['confirmed', 'waitlist']
        && gymusikCreditPaired(appId, reservationId, request.resource.data)
        && request.resource.data.sessionId is string
        && request.resource.data.teacherEmail is string
        && existsAfter(gymusikSessionPath(appId, request.resource.data.sessionId))
        && getAfter(gymusikSessionPath(appId, request.resource.data.sessionId)).data.status == 'published'
        && request.resource.data.sessionDate == getAfter(gymusikSessionPath(appId, request.resource.data.sessionId)).data.date
        && request.resource.data.sessionTime == getAfter(gymusikSessionPath(appId, request.resource.data.sessionId)).data.time
        && request.resource.data.instrument == getAfter(gymusikSessionPath(appId, request.resource.data.sessionId)).data.instrument
        && request.resource.data.teacherEmail == getAfter(gymusikSessionPath(appId, request.resource.data.sessionId)).data.teacherEmail
        && gymusikSessionChanges(appId, reservationId, request.resource.data.sessionId, '', request.resource.data.status)
      );
      allow update: if isAdmin() || (
        teacherMatchesData(appId, resource.data)
        && teacherMatchesData(appId, request.resource.data)
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.studentEmail == resource.data.studentEmail
        && request.resource.data.sessionId == resource.data.sessionId
        && request.resource.data.teacherEmail == resource.data.teacherEmail
        && request.resource.data.status in ['attended', 'no_show']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'attendanceMarkedAt', 'attendanceMarkedBy',
          'creditConsumed', 'updatedAt'
        ])
      ) || (
        studentHasGymusik(appId)
        && studentOwnsResource(appId)
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.studentEmail == resource.data.studentEmail
        && request.resource.data.sessionId == resource.data.sessionId
        && request.resource.data.teacherEmail == resource.data.teacherEmail
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'cancelledAt', 'cancelledBy', 'creditConsumed',
          'creditReturned', 'updatedAt'
        ])
        && gymusikCreditPaired(appId, reservationId, request.resource.data)
        && (
          (
            resource.data.status in ['confirmed', 'waitlist']
            && request.resource.data.status == 'cancelled'
            && validGymusikCancellation(appId, resource.data, request.resource.data)
          )
          || (
            resource.data.status == 'cancelled'
            && request.resource.data.status in ['confirmed', 'waitlist']
          )
        )
        && gymusikSessionChanges(appId, reservationId, resource.data.sessionId, resource.data.status == 'cancelled' ? '' : resource.data.status, request.resource.data.status == 'cancelled' ? '' : request.resource.data.status)
      );
      allow delete: if isAdmin();
    }

    match /artifacts/{appId}/temporaryRelocations/{relocationId} {
      allow read: if isAdmin() || isTeacher(appId) || studentOwnsResource(appId);
      allow write: if isAdmin();
    }

    match /artifacts/{appId}/maintenancePeriods/{periodId} {
      allow read: if isAdmin() || isTeacher(appId) || studentOwnsResource(appId);
      allow write: if isAdmin();
    }

    match /artifacts/{appId}/temporaryClassChanges/{changeId} {
      allow read: if isAdmin() || isTeacher(appId);
      allow write: if isAdmin();
    }

    match /artifacts/{appId}/workshopRegistrations/{registrationId} {
      allow get: if isAdmin() || studentOwnsResource(appId) || deterministicIdBelongsToStudent(appId, registrationId);
      allow list: if isAdmin() || studentOwnsResource(appId);
      allow create: if isAdmin() || studentCreatesOwnResource(appId);
      allow update: if isAdmin() || (
        studentOwnsResource(appId)
        && request.resource.data.studentId == resource.data.studentId
      );
      allow delete: if isAdmin();
    }

    match /artifacts/{appId}/pollResponses/{responseId} {
      allow get: if isAdmin() || studentOwnsResource(appId) || deterministicIdBelongsToStudent(appId, responseId);
      allow list: if isAdmin() || studentOwnsResource(appId);
      allow create: if studentCreatesOwnResource(appId);
      allow update: if studentOwnsResource(appId)
        && request.resource.data.studentId == resource.data.studentId;
      allow delete: if isAdmin();
    }

    match /artifacts/{appId}/callResponses/{responseId} {
      allow get: if isAdmin() || studentOwnsResource(appId) || deterministicIdBelongsToStudent(appId, responseId);
      allow list: if isAdmin() || studentOwnsResource(appId);
      allow create: if studentCreatesOwnResource(appId);
      allow update: if studentOwnsResource(appId)
        && request.resource.data.studentId == resource.data.studentId;
      allow delete: if isAdmin();
    }

    match /artifacts/{appId}/teacherEvaluations/{evaluationId} {
      allow read: if isAdmin() || studentOwnsResource(appId);
      allow create: if studentCreatesOwnResource(appId);
      allow update, delete: if isAdmin();
    }

    match /artifacts/{appId}/teacherNotifications/{notificationId} {
      allow read: if isAdmin() || teacherMatchesData(appId, resource.data);
      allow create: if isAdmin() || teacherMatchesData(appId, request.resource.data);
      allow update: if isAdmin() || (
        teacherMatchesData(appId, resource.data)
        && teacherMatchesData(appId, request.resource.data)
      );
      allow delete: if isAdmin();
    }

    match /artifacts/{appId}/teacherTasks/{taskId} {
      allow read: if isAdmin() || teacherMatchesData(appId, resource.data);
      allow create: if isAdmin() || teacherMatchesData(appId, request.resource.data);
      allow update: if isAdmin() || (
        teacherMatchesData(appId, resource.data)
        && teacherMatchesData(appId, request.resource.data)
      );
      allow delete: if isAdmin() || teacherMatchesData(appId, resource.data);
    }

    match /artifacts/{appId}/availability/{teacherKey} {
      allow read, write: if isAdmin() || (
        isTeacher(appId)
        && teacherKey == get(staffAccessPath(appId)).data.teacherKey
      );
    }

    match /artifacts/{appId}/substitutions/{substitutionId} {
      allow read: if isAdmin() || isTeacher(appId);
      allow create: if isTeacher(appId)
        && request.resource.data.originalTeacherUid == request.auth.uid
        && request.resource.data.status == 'open';
      allow update: if isAdmin() || (
        isTeacher(appId)
        && resource.data.status == 'open'
        && request.resource.data.status == 'assigned'
        && request.resource.data.originalTeacherUid == resource.data.originalTeacherUid
        && resource.data.originalTeacherUid != request.auth.uid
        && request.resource.data.assumedByUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'assumedAt', 'assumedByUid', 'assumedByEmail',
          'assumedTeacherName', 'assumedClassId', 'assumedClassRefPath'
        ])
      );
      allow delete: if isAdmin() || (
        isTeacher(appId) && resource.data.originalTeacherUid == request.auth.uid
      );
    }

    match /artifacts/{appId}/payrollAdjustments/{adjustmentId} {
      allow read: if isAdmin() || (
        isTeacher(appId)
        && resource.data.teacher is string
        && resource.data.teacher.lower() == get(staffAccessPath(appId)).data.teacherNameLower
      );
      allow write: if isAdmin();
    }

    match /artifacts/{appId}/users/{userId} {
      allow read, create, update: if isAdmin() || (
        isTeacher(appId) && request.auth.uid == userId
      );
      allow delete: if isAdmin();

      match /records/{recordId} {
        allow read, write: if isAdmin() || (
          isTeacher(appId) && request.auth.uid == userId
        );
      }

      match /dailyReports/{reportId} {
        allow read, write: if isAdmin() || (
          isTeacher(appId) && request.auth.uid == userId
        );
      }

      match /recurringClasses/{classId} {
        // Las listas son información docente operativa. Los profesores pueden
        // consultarlas, pero las ramas de escritura de abajo siguen limitando
        // quién puede cambiar estructura, asistencia, notas y recursos.
        allow get: if isAdmin() || isTeacher(appId) || (
          hasStudentAccess(appId)
          && 'studentIds' in resource.data
          && resource.data.studentIds is list
          && ownStudentId(appId) in resource.data.studentIds
        );
        allow list: if isAdmin() || isTeacher(appId);
        allow create: if isAdmin() || (
          teacherOwnsNamespace(appId, userId)
          && teacherMatchesData(appId, request.resource.data)
          && teacherInAuthorizedClassEmails(appId, request.resource.data)
        );
        allow delete: if isAdmin();
        allow update: if isAdmin() || (
          teacherMatchesData(appId, resource.data)
          && teacherMatchesData(appId, request.resource.data)
          && request.resource.data.teacher == resource.data.teacher
          && request.resource.data.authorizedTeacherEmails == resource.data.authorizedTeacherEmails
        ) || (
          teacherInAuthorizedClassEmails(appId, resource.data)
          && teacherInAuthorizedClassEmails(appId, request.resource.data)
          && request.resource.data.teacher == resource.data.teacher
          && request.resource.data.authorizedTeacherEmails == resource.data.authorizedTeacherEmails
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'students', 'studentIds', 'exceptions', 'autoCancelled', 'cancelledDates',
            'notes', 'originalNotes', 'resources', 'notesUpdatedAt',
            'notesUpdatedBy', 'notesUpdatedByName'
          ])
        ) || (
          hasStudentAccess(appId)
          && 'studentIds' in resource.data
          && resource.data.studentIds is list
          && ownStudentId(appId) in resource.data.studentIds
          && studentNotifiesOwnAbsence(appId)
        );
      }

      match /tickets/{ticketId} {
        allow read: if isAdmin() || isTeacher(appId) || (
          hasStudentAccess(appId)
          && resource.data.studentEmail is string
          && resource.data.studentEmail == authEmail()
        );
        allow create: if isAdmin() || (
          teacherOwnsNamespace(appId, userId)
          && teacherInTeacherEmails(appId, request.resource.data)
        );
        // Check this narrow attendance correction before the more expensive
        // ordinary ticket-update branches, keeping the atomic batch under the
        // Firestore expression limit without widening any pupil permissions.
        allow update: if isAdmin() || (
          request.resource.data.get('voidReason', '') == 'attendance_confirmed'
          && teacherInvalidatesAttendedTicket(appId, userId)
        ) || (
          teacherCanReadTicket(appId, resource.data)
          && teacherCanReadTicket(appId, request.resource.data)
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.studentEmail == resource.data.studentEmail
          && request.resource.data.subject == resource.data.subject
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'isUsed', 'usedAt', 'usedOn', 'usedInSubject', 'usedInClassId'
          ])
        ) || (
          studentOwnsResource(appId)
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.studentEmail == resource.data.studentEmail
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'recoveryTeacherKeys', 'recoveryTeacherEmails', 'recoveryGestionIds', 'recoveryAuthorizedAt'
          ])
        );
        allow delete: if isAdmin();
      }
    }

    match /{document=**}/recurringClasses/{classId} {
      allow get: if isAdmin() || isTeacher('default-app-id') || (
        hasStudentAccess('default-app-id')
        && 'studentIds' in resource.data
        && resource.data.studentIds is list
        && ownStudentId('default-app-id') in resource.data.studentIds
      );
      allow list: if isAdmin() || isTeacher('default-app-id');
    }

    match /{document=**}/tickets/{ticketId} {
      allow read: if isAdmin() || isTeacher('default-app-id') || (
        hasStudentAccess('default-app-id')
        && resource.data.studentEmail is string
        && resource.data.studentEmail == authEmail()
      );
    }

    match /{document=**}/records/{recordId} {
      allow read: if isAdmin();
    }

    match /artifacts/{appId}/{document=**} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
