rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'paco@escuelalosmitos.com';
    }

    match /studentAvatars/{ownerUid}/{studentId}/profile.webp {
      allow read: if signedIn() && (request.auth.uid == ownerUid || isAdmin());

      allow create, update: if signedIn()
        && request.auth.uid == ownerUid
        && request.resource.size <= 300 * 1024
        && request.resource.contentType == 'image/webp'
        && request.resource.metadata.ownerUid == ownerUid
        && request.resource.metadata.studentId == studentId;

      allow delete: if signedIn() && (request.auth.uid == ownerUid || isAdmin());
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
